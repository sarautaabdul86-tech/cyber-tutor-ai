# GEMINI_API_KEY: Required for Gemma 4 API calls through Google AI Studio.
# In Google AI Studio, this is automatically injected at runtime from your secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PROVIDER: Select the active inference engine:
# 'api'   -> Uses Google AI Studio / Gemini API (Gemma 4 model: gemma-4-31b-it)
# 'local' -> Uses local Ollama instance (default: http://localhost:11434, gemma4:e2b)
PROVIDER="api"

# Optional overrides:
# GEMMA_MODEL="gemma-4-31b-it"
# OLLAMA_ENDPOINT="http://localhost:11434"
# OLLAMA_MODEL="gemma4:e2b"
